{
  "name": "pulsebar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "tauri": "tauri",
    "build:arm64": "CI=true tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "build:x64": "CI=true tauri build --target x86_64-apple-darwin --bundles app,dmg",
    "build:universal": "CI=true tauri build --target universal-apple-darwin --bundles app,dmg"
  },
  "dependencies": {
    "@lucide/svelte": "^1.56.0",
    "@tauri-apps/api": "~2.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "~2.12.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
